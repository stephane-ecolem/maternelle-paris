---
import Base from '../layouts/Base.astro';
import MentionDonnees from '../components/MentionDonnees.astro';
import { ARRONDISSEMENTS, libelle } from '../lib/arrondissements';
import { ANNEES_NAISSANCE, CRITERES, SITE } from '../config';
import { ECOLES } from '../lib/donnees';

const title = 'Écoles maternelles à Paris : école de secteur et liste par arrondissement';
const description = `Trouvez l'école maternelle de secteur de votre adresse à Paris et comparez les écoles publiques et privées proches, pour la rentrée ${SITE.rentree}.`;
---
<Base {title} {description}>
  <section class="bg-white">
    <div class="conteneur py-10 md:py-14">
      <h1 class="max-w-3xl text-3xl md:text-5xl">Quelle école maternelle pour votre enfant à Paris ?</h1>
      <p class="prose-site mt-4 text-lg">
        Saisissez votre adresse : vous obtenez votre école de secteur d'après les secteurs publiés par la Ville de Paris,
        puis les écoles publiques et privées proches, avec pour chacune la raison de sa présence dans la liste.
      </p>

      <form id="shortlist" action="/shortlist/" method="get" class="mt-8 grid max-w-3xl gap-5 rounded-lg border border-ligne bg-fond p-5 md:grid-cols-2">
        <div class="md:col-span-2">
          <label for="adresse" class="font-semibold">Votre adresse à Paris</label>
          <input id="adresse" name="adresse" class="champ mt-1" required autocomplete="street-address" placeholder="Numéro, rue, code postal" />
          <p class="mt-1 text-sm text-gris">Elle sert uniquement à situer votre secteur et n'est pas conservée.</p>
        </div>
        <div>
          <label for="annee" class="font-semibold">Année de naissance de l'enfant</label>
          <select id="annee" name="annee" class="champ mt-1" required>
            {ANNEES_NAISSANCE.map((a) => <option value={a.valeur} selected={a.valeur === '2024'}>{a.libelle}</option>)}
          </select>
        </div>
        <div>
          <label for="critere" class="font-semibold">Critère prioritaire</label>
          <select id="critere" name="critere" class="champ mt-1">
            {CRITERES.map((c) => <option value={c.valeur} selected={c.valeur === 'indifferent'}>{c.libelle}</option>)}
          </select>
        </div>
        <div class="md:col-span-2">
          <button type="submit" class="bouton">Voir les écoles</button>
          <p class="mt-3 text-sm text-gris">Aucun email n'est demandé à cette étape. Rentrée {SITE.rentree}.</p>
        </div>
      </form>
    </div>
  </section>

  <div class="conteneur py-10">
    <section id="arrondissements" aria-labelledby="titre-arr">
      <h2 id="titre-arr" class="text-2xl">Les maternelles par arrondissement</h2>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 md:grid-cols-4">
        {ARRONDISSEMENTS.map((a) => {
          const n = ECOLES.filter((e) => e.arrondissement === a.numero).length;
          return <li><a href={`/${a.slug}/`}>{libelle(a)}</a>{n > 0 && <span class="text-gris"> ({n})</span>}</li>;
        })}
      </ul>
    </section>

    <section class="prose-site mt-10" aria-labelledby="titre-methode">
      <h2 id="titre-methode">Comment cet annuaire est construit</h2>
      <p>
        La liste des écoles provient de l'annuaire de l'éducation publié par le ministère de l'Éducation nationale. Les secteurs
        scolaires proviennent des données ouvertes de la Ville de Paris. Les langues, la pédagogie et l'âge d'accueil des écoles
        privées sont relevés par l'éditeur sur les sites des écoles, avec la source et la date de chaque relevé. Quand une
        information manque, la page affiche « non renseigné ».
      </p>
      <p>Aucune note, aucun classement, aucun avis. Ce site est édité par {SITE.editeur.nom}, qui exploite elle-même des écoles maternelles à Paris.</p>
      <MentionDonnees secteurs />
    </section>
  </div>
</Base>
