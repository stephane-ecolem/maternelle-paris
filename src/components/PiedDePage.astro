---
import { SITE } from '../config';
import { ARRONDISSEMENTS, libelle } from '../lib/arrondissements';
---
<footer class="mt-16 border-t border-ligne bg-white text-sm">
  <div class="conteneur grid gap-8 py-10 md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-semibold">{SITE.nom}</p>
      <p class="mt-1">Un service édité par {SITE.editeur.nom} ({SITE.editeur.raisonSociale}), qui exploite des écoles maternelles bilingues à Paris.</p>
      <p class="mt-3">
        <a href={SITE.editeur.url} class="inline-block" aria-label="École M, site de l'éditeur">
          <span class="inline-block rounded border border-ligne px-3 py-1 font-display">[LOGO ÉCOLE M]</span>
        </a>
      </p>
      <p class="mt-3 text-gris">Site indépendant. Ce n'est pas un service de la Ville de Paris ni de l'Éducation nationale.</p>
    </div>
    <nav aria-label="Arrondissements">
      <p class="font-semibold">Les maternelles par arrondissement</p>
      <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1">
        {ARRONDISSEMENTS.map((a) => <li><a href={`/${a.slug}/`}>{libelle(a)}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="font-semibold">Informations</p>
      <ul class="mt-2 space-y-1">
        <li><a href="/dossier/scolarisation-2-ans/">Scolariser son enfant à 2 ans à Paris</a></li>
        <li><a href="/mentions-legales/">Mentions légales</a></li>
        <li><a href="/confidentialite/">Politique de confidentialité</a></li>
        <li><a href="#" data-gerer-cookies>Gérer les cookies</a></li>
      </ul>
    </div>
  </div>
</footer>
